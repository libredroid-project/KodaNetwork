<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.oneandone.ciso.mobile.app.android"/>
        <package android:name="de.ionos.app"/>
        <package android:name="app.over.editor"/>
        <package android:name="com.godaddy.mobile.android"/>
        <package android:name="com.cloudflare.onedotonedotonedotone"/>
    </queries>

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- kodacluster: the master phone is the USB host here (AOAv2) -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KodaNetwork"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowNativeHeapPointerTagging="false"
        android:largeHeap="true">

        <!-- the system launches this when a usb accessory shows up (kodacluster slave link).
             MANAGE_USB belongs to the system (uid 1000, signature|privileged), so the real
             start still works while other apps cannot trigger this screen anymore. -->
        <activity android:name=".ui.SettingsActivity" android:exported="true"
            android:permission="android.permission.MANAGE_USB">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"/>
            </intent-filter>
            <meta-data android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter"/>
        </activity>
        <activity android:name=".ui.AppLicenseActivity" />
        <activity android:name=".ui.PraetorVersionActivity" android:exported="false"
            android:theme="@style/Theme.KodaNetwork.Translucent" />
        <activity android:name=".ui.PraetorConfirmActivity" 
            android:theme="@style/Theme.KodaNetwork.Translucent"
            />
        <activity android:name=".ui.PraetorMemoryLimitActivity" 
            android:theme="@style/Theme.KodaNetwork.Translucent"
            />
        <activity android:name=".ui.ScreensaverActivity" />
        <activity android:name="eu.kodanetwork.mchost.cluster.ClusterActivity" android:exported="false"/>
        <activity android:name=".ui.PersonalChatActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.WelcomeActivity" android:exported="false" />
        <activity android:name="eu.kodanetwork.mchost.transfer.TransferSenderActivity" android:exported="false" />
        <activity android:name="eu.kodanetwork.mchost.transfer.TransferReceiverActivity" android:exported="false" />
        <activity android:name=".ui.CrisisSupportActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.KodaNetwork"/>
        <activity android:name=".ui.InfraOverloadActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.KodaNetwork"/>

        <activity android:name=".ui.CrashAlertActivity" 
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />

        <activity
            android:name=".ui.design.HomePageActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustResize">
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <activity-alias
            android:name=".ui.MainActivityDefault"
            android:targetActivity=".ui.MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.MainActivityOldIcon"
            android:targetActivity=".ui.MainActivity"
            android:icon="@mipmap/ic_launcher_old"
            android:roundIcon="@mipmap/ic_launcher_old_round"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        
        <activity
            android:name=".ui.MaintenanceActivity"
            android:exported="false"
            />
            
        <activity
            android:name=".ui.BannedActivity"
            android:exported="false"
            />

        <activity
            android:name=".ui.ScaryBannedActivity"
            android:exported="false"
            />

        <activity
            android:name=".ui.DebugWarningActivity"
            android:exported="false"
            />

        <activity
            android:name=".ui.design.LoginPageActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.design.RegisterPageActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.design.DashboardPageActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.design.CompleteSetupPageActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.design.CheckoutPageActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.design.AdminPageActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.CreateServerActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustPan"/>
            
        <activity
            android:name=".ui.LicensesActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustPan"/>

        <activity
            android:name=".ui.CreateDatabaseActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustPan"/>

        <activity
            android:name=".ui.ServerDetailActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.DebugLogActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name="eu.kodanetwork.mchost.extension.ExtensionsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name="eu.kodanetwork.mchost.extension.ExtensionHostActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name="eu.kodanetwork.mchost.extension.ExtensionThemesActivity"
            android:exported="false"/>

        <activity android:name=".ui.FileEditorActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustResize"/>

        <activity android:name=".ui.BanEnforcementActivity"
            android:exported="false"
            
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"/>

        <activity android:name=".ui.PraetorWarningActivity"
            android:exported="false"
            android:theme="@style/Theme.KodaNetwork.Translucent"
            />
            
        <activity android:name=".ui.PraetorHibernateActivity"
            android:exported="false"
            android:theme="@style/Theme.KodaNetwork.Translucent"
            />

        <activity android:name=".ui.LegacyModeWarningActivity"
            android:exported="false"
            android:theme="@style/Theme.KodaNetwork.Translucent"
            />

        <activity android:name=".ui.BiometricAuthActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            />


        <service
            android:name=".service.KodaServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <service
            android:name=".service.IsolatedJvmService1"
            android:exported="false"
            android:process=":jvm1"/>
            
        <service
            android:name=".service.IsolatedJvmService2"
            android:exported="false"
            android:process=":jvm2"/>
            
        <service
            android:name=".service.IsolatedJvmService3"
            android:exported="false"
            android:process=":jvm3"/>
            
        <activity android:name=".ui.PraetorAccountsActivity"
            android:exported="false"
            android:theme="@style/Theme.KodaNetwork"
            />

        <activity android:name=".ui.CreateSupportTicketActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            />
            
        <activity android:name=".ui.SupportTicketListActivity"
            android:exported="false"
            />
            
        <activity android:name=".ui.SupportChatActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustResize"/>
            
        <activity android:name=".ui.UpdateServerActivity"
            android:exported="false"
            />
            
        <activity android:name=".ui.DeleteServerActivity"
            android:exported="false"
            />
        <activity android:name=".ui.TutorialActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.KodaNetwork"
            />
            
        <activity android:name=".ui.CustomDnsWizardActivity"
            android:exported="false"
            
            android:windowSoftInputMode="adjustResize"/>

        <activity android:name=".ui.DownloadJreActivity"
            android:exported="false"
            android:theme="@style/Theme.KodaNetwork.Translucent"/>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="eu.kodanetwork.mchost.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

    </application>
</manifest>
