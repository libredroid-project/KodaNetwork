<resources>
    <!-- the apple (ios settings) skin theme. light base, dark overlay comes from applyTheme. -->
    <style name="Theme.KodaNetwork.Apple" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/apple_accent_light</item>
        <item name="colorPrimaryVariant">@color/apple_accent_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/apple_accent_light</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">@color/apple_group_light</item>
        <item name="colorOnSurface">@color/apple_text_light</item>
        <item name="android:colorBackground">@color/apple_bg_light</item>
        <item name="colorError">@color/apple_red_light</item>
        <item name="android:textColorPrimary">@color/apple_text_light</item>
        <item name="android:textColorSecondary">@color/apple_text_muted_light</item>
        <item name="android:statusBarColor">@color/apple_bg_light</item>
        <item name="android:navigationBarColor">@color/apple_bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/golos_text</item>
        <item name="fontFamily">@font/golos_text</item>
    </style>

    <style name="ThemeOverlay.KodaNetwork.Apple.Light" parent="">
        <item name="colorPrimary">@color/apple_accent_light</item>
        <item name="colorSurface">@color/apple_group_light</item>
        <item name="colorOnSurface">@color/apple_text_light</item>
        <item name="android:colorBackground">@color/apple_bg_light</item>
        <item name="android:textColorPrimary">@color/apple_text_light</item>
        <item name="android:textColorSecondary">@color/apple_text_muted_light</item>
        <item name="android:statusBarColor">@color/apple_bg_light</item>
        <item name="android:navigationBarColor">@color/apple_bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="ThemeOverlay.KodaNetwork.Apple.Dark" parent="">
        <item name="colorPrimary">@color/apple_accent_dark</item>
        <item name="colorSurface">@color/apple_group_dark</item>
        <item name="colorOnSurface">@color/apple_text_dark</item>
        <item name="android:colorBackground">@color/apple_bg_dark</item>
        <item name="android:textColorPrimary">@color/apple_text_dark</item>
        <item name="android:textColorSecondary">@color/apple_text_muted_dark</item>
        <item name="android:statusBarColor">@color/apple_bg_dark</item>
        <item name="android:navigationBarColor">@color/apple_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ios is sans everywhere, big titles get the heavy weight -->
    <style name="TextAppearance.KodaNetwork.Apple.LargeTitle" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">@font/golos_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.KodaNetwork.Apple.Row" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/golos_text</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>
</resources>
