<resources>
    <!-- the notion skin theme. light palette as the base, the dark overlay is applied in
         NotionSkinHelper.applyTheme when theme_mode says dark. -->
    <style name="Theme.KodaNetwork.Notion" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/notion_accent_light</item>
        <item name="colorPrimaryVariant">@color/notion_accent_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/notion_accent_light</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">@color/notion_surface_light</item>
        <item name="colorOnSurface">@color/notion_text_light</item>
        <item name="android:colorBackground">@color/notion_bg_light</item>
        <item name="colorError">#EB5757</item>
        <item name="android:textColorPrimary">@color/notion_text_light</item>
        <item name="android:textColorSecondary">@color/notion_text_muted_light</item>
        <item name="android:statusBarColor">@color/notion_bg_light</item>
        <item name="android:navigationBarColor">@color/notion_bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/golos_text</item>
        <item name="fontFamily">@font/golos_text</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

    <style name="ThemeOverlay.KodaNetwork.Notion.Light" parent="">
        <item name="colorPrimary">@color/notion_accent_light</item>
        <item name="colorSurface">@color/notion_surface_light</item>
        <item name="colorOnSurface">@color/notion_text_light</item>
        <item name="android:colorBackground">@color/notion_bg_light</item>
        <item name="android:textColorPrimary">@color/notion_text_light</item>
        <item name="android:textColorSecondary">@color/notion_text_muted_light</item>
        <item name="android:statusBarColor">@color/notion_bg_light</item>
        <item name="android:navigationBarColor">@color/notion_bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="ThemeOverlay.KodaNetwork.Notion.Dark" parent="">
        <item name="colorPrimary">@color/notion_accent_dark</item>
        <item name="colorSurface">@color/notion_surface_dark</item>
        <item name="colorOnSurface">@color/notion_text_dark</item>
        <item name="android:colorBackground">@color/notion_bg_dark</item>
        <item name="android:textColorPrimary">@color/notion_text_dark</item>
        <item name="android:textColorSecondary">@color/notion_text_muted_dark</item>
        <item name="android:statusBarColor">@color/notion_bg_dark</item>
        <item name="android:navigationBarColor">@color/notion_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- headings carry the serif, body text stays sans, like notion does it -->
    <style name="TextAppearance.KodaNetwork.Notion.Heading" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/literata</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.KodaNetwork.Notion.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/golos_text</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>
</resources>
