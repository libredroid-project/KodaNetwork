<!--
  press feedback for a row on the dark cards. a flat overlay instead of a ripple,
  so a row that starts another screen cannot leave a half drawn highlight behind.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
        </shape>
    </item>
</selector>
