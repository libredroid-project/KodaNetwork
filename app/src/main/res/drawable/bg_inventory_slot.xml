<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- dark base, it shows on the top/left as the shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#373737" />
        </shape>
    </item>
    
    <!-- bright edge on the bottom/right, that is what makes it a slot -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    
    <!-- the slot fill, inset by 2dp -->
    <item android:bottom="2dp" android:right="2dp" android:top="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#8B8B8B" />
        </shape>
    </item>
</layer-list>
