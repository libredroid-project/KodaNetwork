        android:pathData="M0,1620 L200,1480 L360,1570 L540,1420 L720,1560 L880,1440 L1080,1550"/>

    <!-- readability scrim over the whole scene -->
    <path android:fillColor="#B3050508" android:pathData="M0,0h1080v1920h-1080z"/>
