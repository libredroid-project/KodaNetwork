<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- dark base, it is what shows as the shadow on the bottom-right -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0A" />
        </shape>
    </item>
    <!-- light edge on the top-left -->
    <item android:bottom="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#333333" />
        </shape>
    </item>
    <!-- the card face, inset by 4dp so the edges read as a bevel -->
    <item android:bottom="4dp" android:right="4dp" android:top="4dp" android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A1A1A" />
        </shape>
    </item>
</layer-list>
