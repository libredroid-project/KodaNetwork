<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- light edge sits on the bottom-right -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#333333" />
        </shape>
    </item>
    <!-- black shadow, which shows up as a 2dp L on the top-left -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>
    <!-- the actual panel face, inset so the bevel shows through -->
    <item android:bottom="2dp" android:right="2dp" android:top="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D0D0D" />
        </shape>
    </item>
</layer-list>
