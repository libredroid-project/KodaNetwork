<!-- android 12+: an include narrows the backup to that path, so only the
     identity file gets through and no exclude lines are needed. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="koda_identity.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="koda_identity.xml" />
    </device-transfer>
</data-extraction-rules>
