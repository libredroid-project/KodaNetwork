<!--
    plain https everywhere: cleartext traffic gets refused and only the system trust anchors count.

    certificate pinning was dropped on purpose (2026-09-27). the pins pointed at the *leaf*
    certificate of the shared Supabase endpoint (CN=supabase.co, signed by Google Trust Services),
    which rotates regularly - every rotation would have locked every installed app out of the
    backend until a new release shipped. the second pin matched no certificate in any of the
    configured chains, and two of the listed domains (api.kodanetwork.eu, resend.com) are never
    contacted by the app at all.

    endpoints run by third parties must not be pinned to a leaf certificate. if pinning is wanted
    again later, pin the public key of a domain we control and always ship a backup pin.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
