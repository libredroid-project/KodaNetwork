<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0F"
    android:padding="24dp">

    <!-- title: this dialog is ToS, privacy policy and impressum -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LEGAL AGREEMENT"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:fontFamily="@font/font_koda"
        android:layout_marginBottom="16dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- warning sign above the legal text -->
            <TextView
                android:id="@+id/tv_warning_icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠"
                android:textColor="#FF6B00"
                android:textSize="48sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#241C18"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                
                <!-- ToS body, the html gets loaded in code -->
                <TextView
                    android:id="@+id/tv_tos_content"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#F0F0F0" android:textSize="14sp"
                    android:lineSpacingExtra="6dp" android:gravity="left"
                    android:padding="16dp" />
            </androidx.cardview.widget.CardView>
                
        </LinearLayout>
    </ScrollView>

    <!-- decline on the left, accept on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_reject_tos"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1"
            style="@style/KodaButton.Outline"
            android:textColor="#FF3333"
            app:strokeColor="#FF3333"
            android:text="DECLINE"
            android:layout_marginEnd="8dp"
            android:stateListAnimator="@null" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_accept_tos"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1"
            style="@style/KodaButton"
            app:backgroundTint="#00E676"
            android:text="ACCEPT"
            android:layout_marginStart="8dp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
