<?xml version="1.0" encoding="utf-8"?>
<!-- One installed mod or plugin: name, size, enable switch and a trash action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_jar_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8E2D6"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tv_jar_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8A8A9A"
            android:textSize="11sp" />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_jar_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:useMaterialThemeColors="false"
        app:thumbTint="@color/switch_thumb"
        app:trackTint="@color/switch_track" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_jar_trash"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/jars_trash"
        android:textColor="#FF8A80"
        android:textSize="11sp" />
</LinearLayout>
