<!-- the M3 twin of activity_support_chat: the chat keeps the koda look in both themes,
     same ids on purpose so the activity runs against either file -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/support_chat_root"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808">

    <ImageView
        android:id="@+id/iv_chat_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_chat_mountains"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"/>

    <LinearLayout
        android:id="@+id/ll_top_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#D90C0C0C"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:elevation="8dp"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_custom"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_chat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/support_ticket_default_title"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/font_koda"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_chat_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FF8C00"
                android:textSize="11sp"
                android:fontFamily="@font/font_koda"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_export"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_export_custom"
            app:tint="#FF8C00"
            android:tooltipText="@string/chat_export_title" />
    </LinearLayout>

    <View
        android:id="@+id/v_divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#FF6B00"
        android:layout_below="@id/ll_top_bar"/>

    <LinearLayout
        android:id="@+id/ll_connection_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/v_divider"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chat_input_bar"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_connection_problem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_conn_problem"
            android:textColor="#FF8C00"
            android:textSize="12sp"
            android:fontFamily="@font/font_koda"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/v_divider"
        android:paddingTop="12dp"
        android:paddingBottom="96dp"
        android:clipToPadding="false"/>

    <LinearLayout
        android:id="@+id/ll_chat_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/v_divider"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="64dp"
        android:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_chat_wait"
            android:layout_width="140dp"
            android:layout_height="48dp"
            app:lottie_rawRes="@raw/koda_boot"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_empty_hint"
            android:textColor="#B7AE9F"
            android:textSize="12sp"
            android:fontFamily="@font/font_koda"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_attachment_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/ll_input_bar"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_chat_input_bar"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:elevation="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_attachment_preview"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_input"/>

        <TextView
            android:id="@+id/tv_attachment_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="photo.jpg"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/font_koda"
            android:maxLines="1"
            android:ellipsize="middle"/>

        <ImageButton
            android:id="@+id/btn_remove_attachment"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_custom"
            app:tint="#FF5555" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="8dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_chat_input_bar"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:elevation="10dp"
        android:gravity="bottom">

        <ImageButton
            android:id="@+id/btn_attach"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_attach_custom"
            android:contentDescription="@string/chat_attachment"
            app:tint="#FF8C00" />

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:textColor="#FFFFFF"
            android:textColorHint="#7A7A85"
            android:hint="@string/chat_type_reply"
            android:fontFamily="@font/font_koda"
            android:minHeight="44dp"
            android:maxHeight="120dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:inputType="textMultiLine|textCapSentences" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_send_custom"
            android:contentDescription="@string/chat_send"
            app:tint="#FF6B00" />
    </LinearLayout>

</RelativeLayout>
