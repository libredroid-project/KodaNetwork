<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/praetor_confirm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A6000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:background="@drawable/bg_koda_sheet"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#3A3A44"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:id="@+id/tv_praetor_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P.R.A.E.T.O.R."
            android:textSize="11sp"
            android:fontFamily="@font/space_grotesk_regular"
            android:letterSpacing="0.18"/>

        <TextView
            android:id="@+id/tv_confirm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Delete all servers?"
            android:textColor="#F5F5F7"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_koda"
            android:lineSpacingExtra="2dp"/>

        <TextView
            android:id="@+id/tv_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="You are about to delete all servers."
            android:textColor="#BCBCC6"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="@font/font_koda"/>

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:indeterminateTint="#FF5449"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NETWORK "
                android:textColor="#6E6E7A"
                android:textSize="11sp"
                android:fontFamily="@font/font_koda"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/tv_network_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHECKING..."
                android:textColor="#FFA45C"
                android:textSize="11sp"
                android:fontFamily="@font/font_koda"
                android:textStyle="bold"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10"
                android:textColor="#FF8A80"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_koda"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Cancel"
                android:textColor="#BCBCC6"
                android:textSize="13sp"
                android:fontFamily="@font/font_koda"
                android:clickable="true"
                android:focusable="true"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Confirm"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/font_koda"
                app:backgroundTint="#FF5449"
                app:cornerRadius="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
