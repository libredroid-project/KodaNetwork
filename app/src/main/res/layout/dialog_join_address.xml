<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/join_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_koda_sheet"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp"
    android:layout_gravity="bottom"
    android:gravity="center">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:textColor="#6E6E7A"
        android:textSize="11sp"
        android:letterSpacing="0.18"/>

    <TextView
        android:id="@+id/tv_dialog_subtitle"
        android:layout_width="match_parent"
        android:fontFamily="@font/font_koda"
        app:fontFamily="@font/font_koda"
        android:layout_height="wrap_content"
        android:textColor="#F5F5F7"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="start"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tv_dialog_message"
        android:layout_width="match_parent"
        android:fontFamily="@font/font_koda"
        app:fontFamily="@font/font_koda"
        android:layout_height="wrap_content"
        android:textColor="#BCBCC6"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:gravity="start"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/layout_join_input_phase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/container_join_domain"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/domain_switch_bg"
            android:padding="4dp">

            <View
                android:id="@+id/pill_join_domain"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/pill_bg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/wrapper_join_kodanetwork"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/btn_join_kodanetwork"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="kodanetwork.eu"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/font_koda" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/wrapper_join_kodaserv"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/btn_join_kodaserv"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="kodaserv.eu"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="#888899"
                        android:fontFamily="@font/font_koda" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/et_dialog_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/praetor_hint_change_domain"
                android:textColorHint="#555566"
                android:textColor="#FFFFFF"
                android:padding="16dp"
                android:inputType="textNoSuggestions"
                android:gravity="center_vertical|start"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_dialog_suffix"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingEnd="16dp"
                android:text=".kodanetwork.eu"
                android:textColor="#8A8A9A"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_join_steps_phase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="24dp">

        <LinearLayout android:id="@+id/step_row_1"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="10dp">
            <TextView android:id="@+id/step_icon_1"
                android:layout_width="24dp" android:layout_height="24dp"
                android:gravity="center" android:textSize="14sp"
                android:textColor="#8A8A9A" android:text="•" />
            <TextView android:id="@+id/step_text_1"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:paddingStart="12dp"
                android:textColor="#8A8A9A" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/step_row_2"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="10dp">
            <TextView android:id="@+id/step_icon_2"
                android:layout_width="24dp" android:layout_height="24dp"
                android:gravity="center" android:textSize="14sp"
                android:textColor="#555566" android:text="•" />
            <TextView android:id="@+id/step_text_2"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:paddingStart="12dp"
                android:textColor="#555566" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/step_row_3"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="10dp">
            <TextView android:id="@+id/step_icon_3"
                android:layout_width="24dp" android:layout_height="24dp"
                android:gravity="center" android:textSize="14sp"
                android:textColor="#555566" android:text="•" />
            <TextView android:id="@+id/step_text_3"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:paddingStart="12dp"
                android:textColor="#555566" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/step_row_4"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="10dp">
            <TextView android:id="@+id/step_icon_4"
                android:layout_width="24dp" android:layout_height="24dp"
                android:gravity="center" android:textSize="14sp"
                android:textColor="#555566" android:text="✓" />
            <TextView android:id="@+id/step_text_4"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:paddingStart="12dp"
                android:textColor="#555566" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_join_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:text="@string/praetor_action_cancel"
            android:textColor="#BCBCC6"
            android:textSize="13sp"
            android:fontFamily="@font/font_koda"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_confirm"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="4dp"
            android:text="Continue"
            android:textColor="#1A0F00"
            android:textSize="13sp"
            android:fontFamily="@font/font_koda"
            app:backgroundTint="#FF6B00"
            app:cornerRadius="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>

</FrameLayout>