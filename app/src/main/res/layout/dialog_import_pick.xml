<!-- shown after an import: what the folder holds and which file should launch the server -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:orientation="vertical"
    android:background="@drawable/server_card_bg"
    android:padding="18dp">

    <TextView android:id="@+id/tv_import_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="16sp"
        android:fontFamily="@font/font_koda" android:textStyle="bold"/>

    <TextView android:id="@+id/tv_import_summary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#B7AE9F" android:textSize="12sp"
        android:fontFamily="@font/font_koda" android:lineSpacingMultiplier="1.2"/>

    <TextView android:id="@+id/tv_import_launcher_hint"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#FF6B00" android:textSize="11sp"
        android:fontFamily="@font/font_koda" android:letterSpacing="0.08"
        android:textAllCaps="true"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="260dp">
        <LinearLayout android:id="@+id/ll_import_candidates"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <TextView android:id="@+id/tv_import_warnings"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#FF8C38" android:textSize="11sp"
        android:fontFamily="@font/font_koda" android:lineSpacingMultiplier="1.25"
        android:visibility="gone"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_import_cancel" style="@style/KodaButton.Outline"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp"
            android:text="@string/import_pick_cancel"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_import_confirm" style="@style/KodaButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:text="@string/import_pick_confirm"/>
    </LinearLayout>
</LinearLayout>
