<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A6000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_koda_sheet"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#3A3A44"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:id="@+id/tv_praetor_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P.R.A.E.T.O.R."
            android:textSize="11sp"
            android:fontFamily="@font/space_grotesk_regular"
            android:letterSpacing="0.18"/>

        <TextView
            android:id="@+id/tv_hibernate_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/praetor_hibernate_title"
            android:textColor="#F5F5F7"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_koda"
            android:lineSpacingExtra="2dp"/>

        <TextView
            android:id="@+id/tv_praetor_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/praetor_hibernate_warning"
            android:textColor="#BCBCC6"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="@font/font_koda"/>

        <TextView
            android:id="@+id/btn_praetor_explanation"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:text="@string/praetor_hibernate_long_explanation"
            android:textColor="#FFA45C"
            android:textSize="12sp"
            android:fontFamily="@font/font_koda"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tv_praetor_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="10"
            android:textColor="#FFA45C"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_koda"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/btn_praetor_cancel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/praetor_hibernate_cancel"
                android:textColor="#BCBCC6"
                android:textSize="13sp"
                android:fontFamily="@font/font_koda"
                android:clickable="true"
                android:focusable="true"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_praetor_confirm"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/praetor_hibernate_confirm"
                android:textColor="#1A0F00"
                android:textSize="13sp"
                android:fontFamily="@font/font_koda"
                app:backgroundTint="#FF6B00"
                app:cornerRadius="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:enabled="false"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
