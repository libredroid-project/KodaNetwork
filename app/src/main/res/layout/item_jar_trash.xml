<!-- one file in the trash: name plus restore and delete -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_trash_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8E2D6"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tv_trash_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8A8A9A"
            android:textSize="11sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_trash_restore"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/jars_restore"
        android:textColor="#FFB68C"
        android:textSize="11sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_trash_delete"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/jars_delete_forever"
        android:textColor="#FF8A80"
        android:textSize="11sp" />
</LinearLayout>
