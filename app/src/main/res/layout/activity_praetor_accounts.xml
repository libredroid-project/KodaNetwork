<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E0E11"
    android:padding="16dp">

    <!-- title -->
    <TextView
        android:id="@+id/tv_praetor_title"
        android:maxLines="1"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeMaxTextSize="36sp"
        app:autoSizeStepGranularity="2sp"
        android:layout_width="match_parent"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:text="@string/praetor_title"
        android:textColor="#FF6B00"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="@font/space_grotesk_bold"
        app:fontFamily="@font/space_grotesk_bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pra_subtitle"
        android:textColor="#8A8A9A"
        android:textSize="14sp"
        android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/tv_account_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pra_user_unknown"
        android:textColor="#F0F0F0"
        android:textSize="18sp"
        android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_marginBottom="24dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/ll_permissions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- the permission toggles get added here at runtime -->
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_praetor_save"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/pra_apply"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:backgroundTint="#FF0000"
        android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btn_praetor_cancel"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/pra_abort"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#F0F0F0"
        android:backgroundTint="#333333"
        android:fontFamily="@font/space_grotesk_regular"
        app:fontFamily="@font/space_grotesk_regular"
        android:layout_marginTop="8dp"/>

</LinearLayout>
