<?xml version="1.0" encoding="utf-8"?>
<!-- Personal chat with libredroid: messenger style with a pink accent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/personal_chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#171114">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="#1D1714">

        <ImageButton
            android:id="@+id/btn_personal_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_custom"
            app:tint="#FF9EC6" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personal_chat_title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/font_koda"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personal_chat_subtitle"
                android:textColor="#FF9EC6"
                android:textSize="11sp"
                android:fontFamily="@font/font_koda" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#26FF9EC6" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_personal_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/tv_personal_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="32dp"
            android:gravity="center"
            android:text="@string/personal_chat_empty"
            android:textColor="#C9BFB8"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"
            android:fontFamily="@font/font_koda" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:padding="10dp">

        <EditText
            android:id="@+id/et_personal_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_personal_input"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A8A9A"
            android:hint="@string/personal_chat_hint"
            android:minHeight="48dp"
            android:maxHeight="120dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="14.5sp"
            android:inputType="textMultiLine"
            android:imeOptions="actionSend" />

        <ImageButton
            android:id="@+id/btn_personal_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_personal_send"
            android:src="@drawable/ic_send_custom"
            app:tint="#1B1613" />
    </LinearLayout>
</LinearLayout>
