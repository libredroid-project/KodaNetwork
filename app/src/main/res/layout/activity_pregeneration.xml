<!-- live view of a running world pre-generation: progress, estimate and the console tail -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#080808">

    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#0C0C0C" android:paddingStart="16dp" android:paddingEnd="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pregen_back" style="@style/KodaButton.Outline"
            android:layout_width="wrap_content" android:layout_height="32dp"
            android:text="@string/pregen_back" android:textSize="10sp"/>
        <TextView android:id="@+id/tv_pregen_head"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center"
            android:textColor="#F0F0F0" android:textSize="12sp"
            android:fontFamily="@font/font_koda" android:singleLine="true"
            android:ellipsize="end" android:paddingStart="8dp" android:paddingEnd="8dp"/>
        <View android:layout_width="70dp" android:layout_height="1dp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FF6B00"/>

    <!-- before the task runs the three blocks of the server start screen hop, then the
         world map takes over and grows with chunky -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="#0A0A0E">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_pregen_wait"
            android:layout_width="220dp" android:layout_height="80dp"
            android:layout_gravity="center"
            app:lottie_rawRes="@raw/koda_boot"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>

        <eu.kodanetwork.mchost.ui.WorldGenView
            android:id="@+id/worldgen"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone"/>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="#0E0E14"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView android:id="@+id/tv_pregen_state"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#F2EFE9" android:textSize="15sp"
            android:fontFamily="@font/font_koda" android:textStyle="bold"/>

        <ProgressBar android:id="@+id/pb_pregen" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="8dp"
            android:layout_marginTop="10dp" android:max="100"
            android:progressTint="#FF6B00" android:progressBackgroundTint="#241C18"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView android:id="@+id/tv_pregen_percent"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="#FF6B00" android:textSize="13sp"
                android:fontFamily="@font/font_koda" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_pregen_eta"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FF6B00" android:textSize="12sp"
                android:fontFamily="@font/font_koda"/>
        </LinearLayout>

        <TextView android:id="@+id/tv_pregen_stats"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="#888899"
            android:textSize="11sp" android:fontFamily="@font/font_koda"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pregen_action" style="@style/KodaButton"
            android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="12dp" android:visibility="gone"/>

    </LinearLayout>

    <ScrollView android:id="@+id/sv_pregen_log"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="0.6" android:background="#050505" android:padding="10dp">
        <TextView android:id="@+id/tv_pregen_log"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#CCCCCC" android:textSize="11sp"
            android:fontFamily="@font/font_koda_mono"
            android:lineSpacingMultiplier="1.25"
            android:textIsSelectable="true"/>
    </ScrollView>
</LinearLayout>
