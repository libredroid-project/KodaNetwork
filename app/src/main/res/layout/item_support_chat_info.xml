<!-- ticket info card, sits above the messages -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/cell_bg"
    android:padding="12dp"
    android:layout_margin="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_info_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chat_type_support"
            android:textColor="#F2EFE9"
            android:textSize="13sp"
            android:fontFamily="@font/font_koda"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_info_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OPEN"
            android:textColor="#FF8C00"
            android:textSize="11sp"
            android:fontFamily="@font/font_koda"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_info_created"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#888899"
        android:textSize="11sp"
        android:fontFamily="@font/font_koda"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tv_info_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_info_plain"
        android:textColor="#B7AE9F"
        android:textSize="11sp"
        android:fontFamily="@font/font_koda"
        android:layout_marginTop="6dp"/>
</LinearLayout>
