<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheet_jar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_koda_sheet"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#3A3A44"
        android:layout_marginBottom="18dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_praetor_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P.R.A.E.T.O.R."
            android:textSize="11sp"
            android:fontFamily="@font/space_grotesk_regular"
            android:letterSpacing="0.18"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_warning_triangle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠"
            android:textColor="#FF5449"
            android:textSize="15sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_jar_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/sd_start_jar_title"
        android:textColor="#F5F5F7"
        android:textSize="21sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_koda"/>

    <TextView
        android:id="@+id/tv_jar_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/sd_start_jar_message"
        android:textColor="#BCBCC6"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:fontFamily="@font/font_koda"/>

    <TextView
        android:id="@+id/tv_jar_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#8A8A9A"
        android:textSize="12sp"
        android:fontFamily="@font/font_koda"/>

    <TextView
        android:id="@+id/tv_jar_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/sd_start_jar_warning"
        android:textColor="#FF8A80"
        android:textSize="12sp"
        android:fontFamily="@font/font_koda"/>

    <ScrollView
        android:id="@+id/scroll_jar_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none"
        android:fadeScrollbars="false">

        <LinearLayout
            android:id="@+id/layout_jar_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <TextView
            android:id="@+id/btn_jar_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/praetor_action_cancel"
            android:textColor="#BCBCC6"
            android:textSize="13sp"
            android:fontFamily="@font/font_koda"
            android:clickable="true"
            android:focusable="true"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_jar_apply"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/sd_start_jar_apply"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/font_koda"
            app:backgroundTint="#FF5449"
            app:cornerRadius="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"/>
    </LinearLayout>

</LinearLayout>
