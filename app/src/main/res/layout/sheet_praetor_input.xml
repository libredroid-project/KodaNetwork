<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheet_input_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_koda_sheet"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#3A3A44"
        android:layout_marginBottom="18dp"/>

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="P.R.A.E.T.O.R."
        android:textSize="11sp"
        android:fontFamily="@font/space_grotesk_regular"
        android:letterSpacing="0.18"/>

    <TextView
        android:id="@+id/tv_dialog_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/praetor_subtitle_change_name"
        android:textColor="#F5F5F7"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_koda"/>

    <TextView
        android:id="@+id/tv_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/praetor_message_change_name"
        android:textColor="#BCBCC6"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:fontFamily="@font/font_koda"/>

    <EditText
        android:id="@+id/et_dialog_input"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_koda_field"
        android:hint="@string/praetor_hint_change_name"
        android:textColorHint="#6E6E7A"
        android:textColor="#F5F5F7"
        android:textSize="15sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="text"
        android:maxLines="1"
        android:fontFamily="@font/font_koda"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <TextView
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/praetor_action_cancel"
            android:textColor="#BCBCC6"
            android:textSize="13sp"
            android:fontFamily="@font/font_koda"
            android:clickable="true"
            android:focusable="true"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_confirm"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/praetor_action_save"
            android:textColor="#1A0F00"
            android:textSize="13sp"
            android:fontFamily="@font/font_koda"
            app:backgroundTint="#FF6B00"
            app:cornerRadius="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"/>
    </LinearLayout>

</LinearLayout>
