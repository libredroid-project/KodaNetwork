<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_custom"
    android:padding="24dp"
    android:gravity="center"
    android:maxWidth="320dp"
    android:minWidth="220dp">

    <!-- the sentence the character was tapped in, needs a sentence to show up -->
    <LinearLayout
        android:id="@+id/layout_sentence_context"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_sentence_chinese"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="4dp"/>

        <TextView
            android:id="@+id/tv_sentence_pinyin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#999999"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_sentence_english"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F0F0F0"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="16dp" />
    </LinearLayout>

    <!-- the character itself: hanzi, pinyin, translation -->
    <TextView
        android:id="@+id/tv_dict_character"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="字"
        android:textColor="#FFFFFF"
        android:textSize="54sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_dict_pinyin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="zì"
        android:textColor="#FF3333"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <View
        android:layout_width="40dp"
        android:layout_height="2dp"
        android:background="#FF6B00"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_dict_english"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="letter / symbol / character / word"
        android:textColor="#F0F0F0"
        android:textSize="14sp"
        android:gravity="center" />

</LinearLayout>
