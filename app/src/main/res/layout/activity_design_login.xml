<!-- sign in, same surface, wordmark and spacing as the rest of the app -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0807"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tv_praetor_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P.R.A.E.T.O.R."
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/space_grotesk_regular"
            app:fontFamily="@font/space_grotesk_regular"
            android:letterSpacing="0.18" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auth_sign_in_title"
            android:textColor="#F5F5F7"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_koda"
            app:fontFamily="@font/font_koda" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/login_subtitle"
            android:textColor="#8A8A9A"
            android:textSize="13sp"
            android:fontFamily="@font/font_koda"
            app:fontFamily="@font/font_koda" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/auth_email"
            android:textColor="#8A8A9A"
            android:textSize="11sp"
            android:fontFamily="@font/font_koda"
            app:fontFamily="@font/font_koda" />

        <EditText
            android:id="@+id/et_username"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_koda_field"
            android:hint="@string/auth_email_hint"
            android:inputType="textEmailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#F5F5F7"
            android:textColorHint="#666677"
            android:textSize="15sp"
            android:fontFamily="@font/font_koda" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/auth_password"
            android:textColor="#8A8A9A"
            android:textSize="11sp"
            android:fontFamily="@font/font_koda"
            app:fontFamily="@font/font_koda" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_koda_field"
            android:hint="@string/auth_password_hint"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#F5F5F7"
            android:textColorHint="#666677"
            android:textSize="15sp"
            android:fontFamily="@font/font_koda" />

        <CheckBox
            android:id="@+id/cb_legal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:buttonTint="#FF6B00"
            android:textColor="#8A8A9A"
            android:textSize="12sp"
            android:fontFamily="@font/font_koda" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sign_in"
            style="@style/KodaButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/auth_sign_in_button"
            android:textSize="13sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_google"
            style="@style/KodaButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/auth_google"
            android:textSize="13sp"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/tv_create_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/auth_register_title"
            android:textColor="#FF8C38"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/font_koda"
            app:fontFamily="@font/font_koda" />
    </LinearLayout>
</ScrollView>
