<!-- device transfer, sender side. while packing only the small bottom card is
     alive (live file progress), the target/code sections slide up with an
     animation once the blobs are ready. koda dark style. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#171114">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/transfer_main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/transfer_title"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_koda" />

            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="24dp"
                android:background="#FF6B00" />

            <TextView
                android:id="@+id/tv_transfer_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transfer_status_preparing"
                android:textColor="#C9BFB8"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.35"
                android:fontFamily="@font/font_koda" />

            <LinearLayout
                android:id="@+id/ll_transfer_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/section_transfer_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/transfer_target_label"
                    android:textColor="#FF6B00"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/font_koda" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/transfer_status_pick_target"
                    android:textColor="#C9BFB8"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.35"
                    android:fontFamily="@font/font_koda" />

                <LinearLayout
                    android:id="@+id/ll_transfer_targets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_transfer_any_device"
                    style="@style/KodaButton.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/transfer_any_device"
                    android:fontFamily="@font/font_koda"
                    android:textSize="13sp"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_transfer_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/transfer_code_label"
                    android:textColor="#FF6B00"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/font_koda" />

                <TextView
                    android:id="@+id/tv_transfer_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:fontFamily="@font/font_koda" />

                <TextView
                    android:id="@+id/tv_transfer_countdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="#FF6B00"
                    android:textSize="13sp"
                    android:fontFamily="@font/font_koda" />

                <TextView
                    android:id="@+id/tv_transfer_lan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="#8A7F77"
                    android:textSize="11sp"
                    android:fontFamily="@font/font_koda" />

                <TextView
                    android:id="@+id/tv_transfer_code_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/transfer_code_hint"
                    android:textColor="#C9BFB8"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4"
                    android:fontFamily="@font/font_koda" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_transfer_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/transfer_done_title"
                    android:textColor="#8BC34A"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="@font/font_koda" />

                <TextView
                    android:id="@+id/tv_transfer_done"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#C9BFB8"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4"
                    android:fontFamily="@font/font_koda" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_transfer_done"
                    style="@style/KodaButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/transfer_action_done"
                    android:fontFamily="@font/font_koda"
                    android:textSize="13sp"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_transfer_restart"
                style="@style/KodaButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:text="@string/transfer_action_restart"
                android:fontFamily="@font/font_koda"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_transfer_cancel"
                style="@style/KodaButton.Outline"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="@string/transfer_action_cancel"
                android:fontFamily="@font/font_koda"
                android:textSize="13sp"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- packing phase, small card at the bottom with the live file progress -->
    <LinearLayout
        android:id="@+id/card_packing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_pack_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.04"
            android:fontFamily="@font/font_koda" />

        <TextView
            android:id="@+id/tv_pack_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textColor="#8A7F77"
            android:textSize="11sp"
            android:fontFamily="@font/font_koda" />

        <ProgressBar
            android:id="@+id/bar_pack"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:progressTint="#FF6B00"
            android:progressBackgroundTint="#33FF6B00" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_pack_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#8A7F77"
                android:textSize="11sp"
                android:fontFamily="@font/font_koda" />

            <TextView
                android:id="@+id/tv_pack_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:text="@string/transfer_action_cancel"
                android:textColor="#FF6B00"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:fontFamily="@font/font_koda" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
