<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- header container -->
    <LinearLayout android:id="@+id/top_bar_container"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1B1613" android:elevation="4dp">
        
        <LinearLayout android:id="@+id/top_bar" android:layout_width="match_parent" android:layout_height="48dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="20dp">
            <ImageButton android:id="@+id/btn_back"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FF6B00"
                android:scaleType="centerInside"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/new_server" android:textColor="#F0F0F0"
                android:textSize="18sp" android:fontFamily="@font/font_koda"
                android:textStyle="bold" android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
    
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="#FF6B00"/>

    <ScrollView android:id="@+id/main_scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <!-- import buttons, pull a server in from somewhere else -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="24dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_import"
                    style="@style/KodaButton"
                    android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/import_folder"
                    android:backgroundTint="#1A1A24"
                    android:textColor="#8A8A9A"
                    android:fontFamily="@font/font_koda"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="#2A2A35"
                    app:strokeWidth="1dp"
                    android:layout_marginEnd="10dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_import_zip"
                    style="@style/KodaButton"
                    android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/import_zip"
                    android:backgroundTint="#1A1A24"
                    android:textColor="#8A8A9A"
                    android:fontFamily="@font/font_koda"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="#2A2A35"
                    app:strokeWidth="1dp"/>
            </LinearLayout>

            <!-- server name -->
            <LinearLayout android:id="@+id/layout_name_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/server_name_label" android:textColor="#F0F0F0"
                    android:textSize="11sp" android:fontFamily="@font/font_koda"
                    android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/et_name"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/input_field"
                    android:textColor="#F0F0F0" android:textSize="15sp"
                    android:fontFamily="@font/font_koda"
                    android:hint="@string/server_name_hint"
                    android:textColorHint="#3A3A48"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:inputType="text"             android:layout_marginBottom="16dp"/>
            </LinearLayout>

            <!-- address preview, shows the domain the server will get -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/address_preview_bg"
                android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/tv_address_preview_label"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/connect_address_label" android:textColor="#8A8A9A"
                        android:textSize="10sp" android:fontFamily="@font/font_koda"
                        android:letterSpacing="0.1"/>
                    <TextView android:id="@+id/tv_address_preview"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="yourserver.kodanetwork.eu"
                        android:textColor="#F0F0F0" android:textSize="15sp"
                        android:fontFamily="@font/font_koda" android:textStyle="bold"
                        android:layout_marginTop="6dp"/>
                    <TextView android:id="@+id/tv_velocity_label"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Velocity: kodanetwork.eu"
                        android:textColor="#555566" android:textSize="10sp"
                        android:fontFamily="@font/font_koda" android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"/>
                    <FrameLayout android:id="@+id/container_domain"
                        android:layout_width="match_parent" android:layout_height="40dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/domain_switch_bg" android:padding="4dp">
                        
                        <!-- the pill that slides under the selected option -->
                        <View android:id="@+id/pill_domain"
                            android:layout_width="0dp" android:layout_height="match_parent"
                            android:background="@drawable/pill_bg" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:orientation="horizontal">
                            <FrameLayout android:id="@+id/wrapper_domain_kodanetwork"
                                android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="1">
                                <TextView android:id="@+id/btn_domain_kodanetwork"
                                    android:layout_width="match_parent" android:layout_height="match_parent"
                                    android:text="kodanetwork.eu"
                                    android:gravity="center" android:textSize="11sp"
                                    android:maxLines="1" android:ellipsize="end"
                                    android:textColor="#FFFFFF" android:fontFamily="@font/font_koda" />
                            </FrameLayout>
                            <FrameLayout android:id="@+id/wrapper_domain_kodaserv"
                                android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="1">
                                <TextView android:id="@+id/btn_domain_kodaserv"
                                    android:layout_width="match_parent" android:layout_height="match_parent"
                                    android:text="kodaserv.eu"
                                    android:gravity="center" android:textSize="11sp"
                                    android:maxLines="1" android:ellipsize="end"
                                    android:textColor="#888899" android:fontFamily="@font/font_koda" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="NEW" android:textSize="8sp" android:textColor="#FFFFFF"
                                    android:background="@drawable/badge_new_bg"
                                    android:paddingStart="4dp" android:paddingEnd="4dp"
                                    android:paddingTop="2dp" android:paddingBottom="2dp"
                                    android:layout_gravity="top|end"
                                    android:layout_marginTop="2dp" android:layout_marginEnd="6dp"
                                    android:fontFamily="@font/font_koda"/>
                            </FrameLayout>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

            <!-- server type -->
            <LinearLayout android:id="@+id/layout_type_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/server_type_label" android:textColor="#F0F0F0"
                    android:textSize="11sp" android:fontFamily="@font/font_koda"
                    android:letterSpacing="0.1" android:layout_marginBottom="10dp"/>
                <NumberPicker android:id="@+id/np_server_type"
                    android:layout_width="match_parent" android:layout_height="120dp"
                    android:layout_marginBottom="20dp"
                    android:theme="@style/NumberPickerTheme"/>
            </LinearLayout>

                <!-- version picker -->
                <LinearLayout android:id="@+id/layout_version_section"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/version_label" android:textColor="#F0F0F0"
                        android:textSize="11sp" android:fontFamily="@font/font_koda"
                        android:letterSpacing="0.1"/>
                    <TextView android:id="@+id/tv_version_loading"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="..." android:textColor="#555566"
                        android:textSize="11sp" android:fontFamily="@font/font_koda"/>
                </LinearLayout>
                <TextView android:id="@+id/tv_type_unsupported"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/input_field"
                    android:padding="16dp" android:layout_marginBottom="20dp"
                    android:gravity="center"
                    android:textColor="#FF8C38"
                    android:textSize="13sp" android:fontFamily="@font/font_koda"
                    android:visibility="gone"/>
                <!-- dev only: which java runtime got preselected -->
                <TextView android:id="@+id/tv_dev_java_runtime"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="4dp" android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:textColor="#FF8C38"
                    android:textSize="11sp" android:fontFamily="@font/font_koda"
                    android:visibility="gone"/>
                <LinearLayout android:id="@+id/layout_version_picker"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/input_field"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:layout_marginBottom="20dp"
                    android:clickable="true" android:focusable="true">

                    <TextView
                        android:id="@+id/tv_version_selected"
                        android:layout_width="328dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/font_koda"
                        android:text="Versions still loading..."
                        android:textColor="#F0F0F0"
                        android:textSize="15sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="▼" android:textColor="#FF6B00"
                        android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- world type and seed, written into server.properties before the first start -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/world_type_label" android:textColor="#F0F0F0"
                    android:textSize="13sp" android:layout_marginBottom="4dp"/>
                <Spinner android:id="@+id/spinner_world_type"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:background="#1B1613" android:popupBackground="#241C18"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/world_seed_label" android:textColor="#F0F0F0"
                    android:textSize="13sp" android:layout_marginTop="12dp" android:layout_marginBottom="4dp"/>
                <EditText android:id="@+id/et_world_seed"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:background="#1B1613" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:hint="@string/world_seed_hint" android:inputType="text"/>
            </LinearLayout>

            <!-- pre-generate the world (chunky) on the first start -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:id="@+id/row_pregenerate"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/extras_pregen" android:textColor="#F0F0F0"
                        android:textSize="13sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="@string/extras_pregen_summary"
                        android:textColor="#888899" android:textSize="11sp"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_pregenerate"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    app:useMaterialThemeColors="false" app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track" />
            </LinearLayout>

            <!-- unfolds under the pre-generation switch: radius and what it costs, kept as
                 plain as the ram slider below -->
            <LinearLayout android:id="@+id/layout_pregen_options"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="20dp"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/pregen_radius_label"
                        android:textColor="#F0F0F0" android:textSize="11sp"
                        android:fontFamily="@font/font_koda" android:letterSpacing="0.1"/>
                    <TextView android:id="@+id/tv_pregen_inline_radius"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#F0F0F0" android:textSize="16sp"
                        android:fontFamily="@font/font_koda" android:textStyle="bold"/>
                </LinearLayout>
                <SeekBar android:id="@+id/sb_pregen_inline"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="19" android:progress="3"
                    android:progressTint="#FF6B00" android:thumbTint="#FF8C38"
                    android:progressBackgroundTint="#1A1A24"
                    android:layout_marginBottom="2dp"/>
                <TextView android:id="@+id/tv_pregen_inline_estimate"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#888899" android:textSize="10sp"
                    android:lineSpacingMultiplier="1.25"
                    android:fontFamily="@font/font_koda"/>
            </LinearLayout>

            <!-- ram slider -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ram_label" android:textColor="#F0F0F0"
                    android:textSize="11sp" android:fontFamily="@font/font_koda"
                    android:letterSpacing="0.1"/>
                <TextView android:id="@+id/tv_ram_value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#F0F0F0" android:textSize="16sp"
                    android:fontFamily="@font/font_koda" android:textStyle="bold"/>
            </LinearLayout>
            <SeekBar android:id="@+id/seek_ram"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:progressTint="#FF6B00" android:thumbTint="#FF8C38"
                android:progressBackgroundTint="#1A1A24"
                android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/tv_ram_budget"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#888899" android:textSize="10sp"
                android:fontFamily="@font/font_koda"
                android:layout_marginBottom="8dp"
                android:visibility="gone"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="20dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="512MB"
                    android:textColor="#555566" android:textSize="10sp"
                    android:fontFamily="@font/font_koda"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="8GB" android:textColor="#555566"
                    android:textSize="10sp" android:fontFamily="@font/font_koda"/>
            </LinearLayout>



            <!-- execution mode, how the server process gets started -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/server_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="24dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/execution_mode_native" android:textColor="#F0F0F0"
                        android:textSize="14sp" android:fontFamily="@font/font_koda"
                        android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/execution_mode_desc"
                        android:textColor="#8A8A9A" android:textSize="12sp"
                        android:fontFamily="@font/font_koda"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_use_native"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true" android:enabled="true"/>
            </LinearLayout>

            <!-- setup option, normal server or a modpack -->
            <LinearLayout android:id="@+id/layout_setup_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/setup_design_label" android:textColor="#F0F0F0"
                    android:textSize="11sp" android:fontFamily="@font/font_koda"
                    android:letterSpacing="0.1" android:layout_marginBottom="10dp"/>
                <RadioGroup android:id="@+id/rg_setup_type"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginBottom="20dp"
                    android:background="@drawable/server_card_bg"
                    android:padding="16dp">
                    <RadioButton android:id="@+id/rb_setup_koda"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/setup_koda"
                        android:textColor="#F0F0F0" android:fontFamily="@font/font_koda"
                        android:textSize="13sp"
                        android:checked="true" android:buttonTint="#FF6B00"
                        android:paddingStart="8dp" android:paddingTop="4dp"
                        android:paddingBottom="4dp"/>
                    <RadioButton android:id="@+id/rb_setup_manual"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/setup_manual"
                        android:textColor="#F0F0F0" android:fontFamily="@font/font_koda"
                        android:textSize="13sp"
                        android:buttonTint="#FF6B00"
                        android:paddingStart="8dp" android:paddingTop="4dp"
                        android:paddingBottom="4dp"/>
                    <RadioButton android:id="@+id/rb_setup_ai"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/setup_ai"
                        android:textColor="#F0F0F0" android:fontFamily="@font/font_koda"
                        android:textSize="13sp"
                        android:buttonTint="#FF6B00"
                        android:paddingStart="8dp" android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone"/> <!-- only made visible in code for the owner account -->
                    <RadioButton android:id="@+id/rb_setup_modpack"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/modpack_button"
                        android:textColor="#FF8C38" android:fontFamily="@font/font_koda"
                        android:textSize="13sp" android:textStyle="bold"
                        android:buttonTint="#FF6B00"
                        android:background="@drawable/border_modpack_option"
                        android:paddingStart="8dp" android:paddingTop="10dp"
                        android:paddingEnd="8dp" android:paddingBottom="10dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>
                </RadioGroup>

                <!-- which modpack is picked, fabric only -->
                <TextView android:id="@+id/tv_modpack_selected"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#FF8C38" android:textSize="12sp"
                    android:fontFamily="@font/font_koda"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- ai chat, hidden by default -->
            <LinearLayout android:id="@+id/layout_ai_prompt"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone"
                android:layout_marginBottom="20dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/ai_chat_label" android:textColor="#F0F0F0"
                        android:textSize="11sp" android:fontFamily="@font/font_koda"
                        android:letterSpacing="0.1" android:layout_centerVertical="true"/>
                    <ImageButton android:id="@+id/btn_ai_fullscreen"
                        android:layout_width="32dp" android:layout_height="32dp"
                        android:layout_alignParentEnd="true" android:layout_centerVertical="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_crop" app:tint="#8A8A9A" />
                </RelativeLayout>
                
                <ScrollView android:id="@+id/sv_ai_chat"
                    android:layout_width="match_parent" android:layout_height="200dp"
                    android:background="@drawable/server_card_bg"
                    android:padding="8dp" android:layout_marginBottom="12dp">
                    <LinearLayout android:id="@+id/ll_ai_chat"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <EditText android:id="@+id/et_ai_prompt"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/input_field"
                        android:textColor="#F0F0F0" android:textSize="14sp"
                        android:fontFamily="@font/font_koda"
                        android:hint="@string/ai_chat_hint"
                        android:textColorHint="#3A3A48"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:inputType="text" android:singleLine="true"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ai_send"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        app:icon="@android:drawable/ic_menu_send"
                        app:iconTint="#FFFFFF"
                        app:backgroundTint="#FF6B00"
                        app:cornerRadius="12dp"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        android:padding="0dp"
                        android:insetTop="0dp" android:insetBottom="0dp"/>
                </LinearLayout>
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ai_approve"
                    android:layout_width="match_parent" android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/ai_approve_btn"
                    android:textSize="14sp" android:fontFamily="@font/font_koda"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#00E676"
                    app:cornerRadius="12dp"
                    android:visibility="gone"/>
                
                <TextView android:id="@+id/tv_ai_chat_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/ai_chat_desc"
                    android:textColor="#8A8A9A" android:textSize="11sp"
                    android:layout_marginTop="8dp" android:gravity="center_horizontal"/>
            </LinearLayout>

            <!-- theme colour picker -->
            <LinearLayout android:id="@+id/layout_theme_color"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="32dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/theme_color_label" android:textColor="#F0F0F0"
                    android:textSize="11sp" android:fontFamily="@font/font_koda"
                    android:letterSpacing="0.1" android:layout_marginBottom="10dp"/>
                <LinearLayout android:id="@+id/btn_color_picker"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/color_picker_bg"
                    android:paddingStart="16dp" android:paddingEnd="16dp">
                    <View android:id="@+id/color_preview"
                        android:layout_width="28dp" android:layout_height="28dp"
                        android:background="@drawable/color_preview_circle"
                        android:layout_marginEnd="16dp"/>
                    <TextView android:id="@+id/tv_color_hex"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="#FF6B00" android:textColor="#F0F0F0"
                        android:fontFamily="@font/font_koda"
                        android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/tap_to_change" android:textColor="#555566"
                        android:textSize="11sp" android:fontFamily="@font/font_koda"/>
                </LinearLayout>
            </LinearLayout>

            <!-- the create button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create"
                style="@style/KodaButton"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="@string/btn_create_server"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/font_koda"
                android:textStyle="bold"
                app:backgroundTint="#FF6B00"
                app:cornerRadius="12dp"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- fullscreen overlay while java gets extracted -->
    <FrameLayout
        android:id="@+id/layout_java_extract"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD0A0807"
        android:elevation="10dp"
        android:visibility="gone">
        
        <View
            android:id="@+id/java_extract_light_blob"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_light_blob"/>
            
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center">
            <ProgressBar
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:indeterminateTint="#FF6B00"/>
            <TextView
                android:id="@+id/tv_extract_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/preparing_java"
                android:textColor="#F0F0F0"
                android:textSize="18sp"
                android:fontFamily="@font/font_koda"
                android:textStyle="bold"
                android:gravity="center"
                android:textAlignment="center"
                android:letterSpacing="0.05"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
