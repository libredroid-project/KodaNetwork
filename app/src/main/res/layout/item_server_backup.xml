<?xml version="1.0" encoding="utf-8"?>
<!-- One stored backup: when, how big, and what can be done with it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33241C18" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_backup_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F2E6E0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_backup_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8A8A9A"
                android:textSize="11sp"
                android:fontFamily="@font/font_koda_mono" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_backup_restore"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/extras_backup_restore"
            android:textColor="#F2E6E0"
            android:textSize="11sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_backup_delete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:layout_marginStart="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/extras_backup_delete"
            android:textColor="#FF8A80"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
