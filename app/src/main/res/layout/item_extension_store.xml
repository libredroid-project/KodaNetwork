<!-- one store entry: same row shape as an installed extension, but with the install button -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/cell_bg"
    android:foreground="?attr/selectableItemBackground"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/iv_ext_store_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="#26221E"
        android:scaleType="centerCrop"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_ext_store_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F2EFE9"
            android:textSize="15sp"
            android:fontFamily="@font/font_koda"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_ext_store_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#B7AE9F"
            android:textSize="12sp"
            android:fontFamily="@font/font_koda"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_ext_store_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#8A8A9A"
            android:textSize="11sp"
            android:fontFamily="@font/font_koda"
            android:singleLine="true" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_ext_store_action"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="10dp"
        android:minWidth="0dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="11sp"
        android:fontFamily="@font/font_koda"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:backgroundTint="#FF6B00"
        android:text="@string/ext_store_install" />
</LinearLayout>
