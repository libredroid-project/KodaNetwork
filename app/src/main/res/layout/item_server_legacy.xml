<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/container_main"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1D1714">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- top row: icon, name, status badge -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView android:id="@+id/iv_server_icon"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/server_icon_bg"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    
                    <TextView android:id="@+id/tv_name"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Server Name" android:textColor="#F0F0F0"
                        android:textSize="18sp" android:fontFamily="@font/font_koda"
                        android:textStyle="bold"
                        android:maxLines="1" android:ellipsize="end" />
                        
                    <TextView android:id="@+id/tv_addr"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="address.kodaserv.eu" android:textColor="#8A8A9A"
                        android:textSize="12sp" android:fontFamily="@font/font_koda"
                        android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>

                <!-- status badge -->
                <LinearLayout
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/pill_address_bg"
                    android:backgroundTint="#222226"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp">
                    
                    <View android:id="@+id/dot"
                        android:layout_width="8dp" android:layout_height="8dp"
                        android:background="@drawable/dot_offline"
                        android:layout_marginEnd="6dp" />
                        
                    <TextView android:id="@+id/tv_badge"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="OFFLINE" android:textColor="#8A8A9A"
                        android:textSize="10sp" android:fontFamily="@font/font_koda"
                        android:textStyle="bold" android:letterSpacing="0.05" />
                </LinearLayout>

            </LinearLayout>

            <!-- middle row: version, uptime, tps -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                
                <TextView android:id="@+id/tv_ver"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Version 1.21" android:textColor="#AAAAAA"
                    android:textSize="12sp" android:fontFamily="@font/font_koda" />
                    
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="  •  " android:textColor="#555555"
                    android:textSize="12sp" />
                    
                <TextView android:id="@+id/tv_uptime"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="00:00:00" android:textColor="#AAAAAA"
                    android:textSize="12sp" android:fontFamily="@font/font_koda" />
                    
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="  •  TPS: " android:textColor="#555555"
                    android:textSize="12sp" />
                    
                <TextView android:id="@+id/tv_tps"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="20.0" android:textColor="#00E676"
                    android:textSize="12sp" android:fontFamily="@font/font_koda"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- bottom row: ram bar and the start button -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="RAM" android:textColor="#8A8A9A"
                            android:textSize="10sp" android:fontFamily="@font/font_koda"
                            android:layout_marginEnd="6dp" />
                        <TextView android:id="@+id/tv_ram"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="1.3 / 1.9GB" android:textColor="#E0E0E0"
                            android:textSize="10sp" android:fontFamily="@font/font_koda" />
                    </LinearLayout>
                    
                    <ProgressBar android:id="@+id/pb_ram"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="4dp"
                        android:progressDrawable="@drawable/custom_progress_bar"
                        android:progress="68" android:max="100" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_action"
                    android:layout_width="100dp" android:layout_height="40dp"
                    android:text="START"
                    android:textColor="#111111" android:textSize="13sp"
                    android:fontFamily="@font/font_koda" android:textStyle="bold"
                    app:backgroundTint="#FF6B00" app:cornerRadius="20dp"
                    android:insetTop="0dp" android:insetBottom="0dp" />

            </LinearLayout>
            </LinearLayout>
            
            <View android:id="@+id/status_line"
                android:layout_width="match_parent" android:layout_height="3dp"
                android:background="#2A2A30" />
                
        </LinearLayout>

    <!-- hidden, but the ids have to stay or the adapter npes -->
    <TextView android:id="@+id/tv_type" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/tv_players" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <ProgressBar android:id="@+id/pb_battery" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
        android:max="100" />
    <TextView android:id="@+id/tv_battery" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/divider" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/left_panel" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</FrameLayout>
