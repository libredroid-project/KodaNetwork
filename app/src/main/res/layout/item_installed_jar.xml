<!-- one installed mod/plugin: icon, name on top, description, version at the bottom -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/cell_bg"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/iv_jar_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="#26221E"
        android:scaleType="centerCrop"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_jar_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F2EFE9"
            android:textSize="16sp"
            android:fontFamily="@font/font_koda"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_jar_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#B7AE9F"
            android:textSize="12sp"
            android:fontFamily="@font/font_koda"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_jar_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FF6B00"
            android:textSize="12sp"
            android:fontFamily="@font/font_koda"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="8dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_jar_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:useMaterialThemeColors="false"
            app:thumbTint="@color/switch_thumb"
            app:trackTint="@color/switch_track" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_jar_trash"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/jars_trash"
            android:textColor="#FF8A80"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
