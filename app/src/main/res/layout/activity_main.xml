<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:id="@+id/main_root_layout"
    android:saveEnabled="false"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0A0807"
    android:orientation="vertical">

    <!-- ┌─ TOP BAR ─────────────────────────────────────────────────────┐ -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:id="@+id/main_top_bar"
        android:background="#0A0807"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:elevation="4dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textColor="#FF8C00"
                android:textSize="12sp" android:fontFamily="@font/press_start_2p" android:textStyle="normal"
                android:shadowColor="#FF4500" android:shadowDx="1.0" android:shadowDy="1.0" android:shadowRadius="1.5"
                android:maxLines="1"         app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="6sp"
                app:autoSizeMaxTextSize="12sp"/>
        </LinearLayout>

        <TextView android:id="@+id/tv_server_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_marginEnd="16dp"
            android:text="" android:textColor="#8A8A9A"
            android:textSize="11sp" android:fontFamily="@font/font_koda" android:letterSpacing="0.1"/>

        <TextView android:id="@+id/btn_debug_log" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/log_button" android:textColor="#8A8A9A"
            android:textSize="11sp" android:fontFamily="@font/font_koda" android:letterSpacing="0.1"
            android:layout_marginEnd="16dp" android:background="?attr/selectableItemBackground" android:padding="4dp"/>

        <!-- Black & white icons (Lucide / Simple Icons), tinted like the old emoji grey -->
        <ImageButton android:id="@+id/btn_discord_main"
            android:layout_width="18dp" android:layout_height="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_si_discord"
            app:tint="#8A8A9A"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/discord_open"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ImageButton android:id="@+id/btn_github_main"
            android:layout_width="18dp" android:layout_height="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_si_github"
            app:tint="#8A8A9A"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/github_open_source"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ImageButton android:id="@+id/btn_support_main"
            android:layout_width="18dp" android:layout_height="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_lucide_lifering"
            app:tint="#8A8A9A"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/support"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ImageButton android:id="@+id/btn_donate_main"
            android:layout_width="18dp" android:layout_height="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_lucide_coffee"
            app:tint="#8A8A9A"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/support"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ImageButton android:id="@+id/btn_settings"
            android:layout_width="18dp" android:layout_height="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_lucide_settings"
            app:tint="#8A8A9A"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/settings"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <!-- Orange accent line -->
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="#FF6B00"/>

        <LinearLayout android:id="@+id/vps_status_bar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackground"
            android:clickable="true" android:focusable="true">

            <View android:id="@+id/vps_status_dot"
                android:layout_width="8dp" android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/dot_online"/>

            <TextView android:id="@+id/vps_status_text"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textColor="#B5B5B8" android:textSize="11sp"
                android:fontFamily="@font/font_koda"/>
        </LinearLayout>

    <!-- Server list -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingBottom="80dp"
            android:paddingTop="0dp"/>

        <!-- Empty state -->
        <LinearLayout android:id="@+id/tv_empty"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center"
            android:visibility="gone"
            android:padding="32dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <ImageView android:layout_width="64dp" android:layout_height="64dp"
                android:src="@drawable/ic_server_simple"
                android:layout_marginBottom="16dp" android:alpha="0.6"/>
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/no_servers_yet" android:textColor="#8A8A9A"
                android:textSize="16sp" android:fontFamily="@font/font_koda"
                android:layout_marginBottom="8dp"/>
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/create_first_server_desc"
                android:textColor="#555566" android:textSize="13sp" android:fontFamily="@font/font_koda"/>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <!-- Bottom bar with FAB -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#1A1A24"/>
    <LinearLayout android:id="@+id/main_bottom_bar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#16110D"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="6dp" android:paddingBottom="6dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="kodanetwork.eu" android:textColor="#2A2A35"
            android:textSize="11sp" android:fontFamily="@font/font_koda"/>
        
        <com.google.android.material.button.MaterialButton android:id="@+id/fab_add_db"
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:text="＋ DB" android:textColor="#AAAAAA"
            android:textSize="11sp" android:fontFamily="@font/font_koda"
            android:backgroundTint="#1A1A24"
            app:cornerRadius="20dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            app:strokeColor="#2A2A35" app:strokeWidth="1dp"/>
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/fab_add"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/new_server_btn" android:textColor="#FFFFFF"
            android:textSize="13sp" android:fontFamily="@font/font_koda"
            app:backgroundTint="#FF6B00" app:iconTint="#FFFFFF"
            app:elevation="4dp" app:pressedTranslationZ="8dp"/>
    </LinearLayout>

</LinearLayout>
