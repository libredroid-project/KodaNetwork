<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_website_card"
    android:clipToOutline="true"
    android:clickable="true"
    android:elevation="4dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:stateListAnimator="@animator/website_card_press">

    <!-- inset top highlight: the glass edge of the website cards -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2FFFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp">

        <eu.kodanetwork.mchost.ui.StatusRingFrame
            android:id="@+id/icon_status_frame"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="3dp">

            <ImageView
                android:id="@+id/iv_server_icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_website_icon_circle"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_server_simple" />
        </eu.kodanetwork.mchost.ui.StatusRingFrame>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/space_grotesk_medium"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/jetbrains_mono_regular"
                    android:maxLines="1"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/iv_copy"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/website_copy_address"
                    android:focusable="true"
                    android:padding="3dp"
                    android:src="@drawable/ic_website_copy" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#14FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:letterSpacing="0.06"
                android:text="@string/website_players"
                android:textColor="#71717A"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_players"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:textColor="#F4F4F5"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:letterSpacing="0.06"
                android:text="@string/website_memory"
                android:textColor="#71717A"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_ram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:textColor="#F4F4F5"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:letterSpacing="0.06"
                android:text="@string/website_version"
                android:textColor="#71717A"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:maxLines="1"
                android:textColor="#F4F4F5"
                android:textSize="14sp"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_ram"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#1FFFFFFF"
        android:progressTint="#FF8C38" />

    <TextView
        android:id="@+id/tv_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:textColor="#71717A"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#14FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_website_footer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="28dp">

            <TextView
                android:id="@+id/btn_start"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_website_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/font_koda"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:stateListAnimator="@animator/website_pill_press"
                android:text="@string/website_start"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/pb_start_spin"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="4dp">

            <TextView
                android:id="@+id/btn_restart"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_website_pill_ghost"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/font_koda"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:stateListAnimator="@animator/website_pill_press"
                android:text="@string/website_restart"
                android:textColor="#A1A1AA"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/pb_restart_spin"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#A1A1AA"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="4dp">

            <TextView
                android:id="@+id/btn_stop"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_website_pill_ghost"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/font_koda"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:stateListAnimator="@animator/website_pill_press"
                android:text="@string/website_stop"
                android:textColor="#F87171"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/pb_stop_spin"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#F87171"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
