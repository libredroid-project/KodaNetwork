<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/bannedWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P.R.A.E.T.O.R."
            android:textSize="11sp"
            android:fontFamily="@font/space_grotesk_regular"
            android:letterSpacing="0.18"/>

        <TextView
            android:id="@+id/bannedSubtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="ACCOUNT SUSPENDED"
            android:textColor="#F5F5F7"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="@font/space_grotesk_bold"
            android:lineSpacingExtra="2dp"/>

        <TextView
            android:id="@+id/bannedReasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Your device has been permanently banned from the KodaHosting network due to violations of our terms of service."
            android:textSize="15sp"
            android:textColor="#BCBCC6"
            android:lineSpacingExtra="4dp"
            android:fontFamily="@font/font_koda"/>

        <TextView
            android:id="@+id/bannedHwidText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="HWID: ..."
            android:textSize="12sp"
            android:textColor="#6E6E7A"
            android:fontFamily="@font/space_grotesk_regular"/>

    </LinearLayout>
</ScrollView>
