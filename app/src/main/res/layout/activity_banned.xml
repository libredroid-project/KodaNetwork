<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bannedWordmark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="P.R.A.E.T.O.R."
                android:textSize="11sp"
                android:fontFamily="@font/space_grotesk_regular"
                android:letterSpacing="0.18" />

            <ImageButton
                android:id="@+id/bannedChatButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ban_appeal_chat"
                android:padding="10dp"
                android:src="@drawable/ic_chat_bubble"
                android:tint="#F5F5F7"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/bannedSubtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/ban_title"
            android:textColor="#FF5252"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_koda"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/bannedBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ban_body"
            android:textSize="15sp"
            android:textColor="#BCBCC6"
            android:lineSpacingExtra="4dp"
            android:fontFamily="@font/font_koda" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ban_reason_label"
                android:textColor="#8A8A9A"
                android:textSize="11sp"
                android:fontFamily="@font/font_koda"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/bannedReasonText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ban_reason_default"
                android:textSize="14sp"
                android:textColor="#F0F0F0"
                android:lineSpacingExtra="3dp"
                android:fontFamily="@font/font_koda" />
        </LinearLayout>

        <TextView
            android:id="@+id/bannedAppealText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ban_appeal_default"
            android:textSize="14sp"
            android:textColor="#BCBCC6"
            android:lineSpacingExtra="4dp"
            android:fontFamily="@font/font_koda" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bannedAppealButton"
            style="@style/KodaButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/ban_appeal_button"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:visibility="gone"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/bannedServersNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/ban_servers_hibernate_note"
            android:textColor="#FF8A80"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="@font/font_koda"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bannedServersButton"
            style="@style/KodaButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#241C18"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/ban_servers_button"
            android:textAllCaps="false"
            android:textColor="#F0F0F0"
            android:textSize="14sp"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/bannedHwidText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/ban_hwid_label"
            android:textSize="11sp"
            android:textColor="#6E6E7A"
            android:fontFamily="@font/space_grotesk_regular" />

    </LinearLayout>
</ScrollView>
