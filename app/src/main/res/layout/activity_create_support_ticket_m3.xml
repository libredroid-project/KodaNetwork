<!-- bug report and server report form, koda look: cards on the dark screen, orange accents -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="#080808">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0C0C0C"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_custom"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/create_support_ticket"
            android:textColor="#F0F0F0"
            android:textSize="15sp"
            android:fontFamily="@font/font_koda"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#FF6B00"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#241C18"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subject_reference"
                        android:textColor="#FF6B00"
                        android:textSize="11sp"
                        android:letterSpacing="0.1"
                        android:fontFamily="@font/font_koda"
                        android:layout_marginBottom="10dp"/>

                    <EditText
                        android:id="@+id/et_reference"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input"
                        android:textColor="#F2EFE9"
                        android:textColorHint="#7A7A85"
                        android:hint="@string/subject_hint"
                        android:padding="14dp"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_koda"
                        android:inputType="textCapSentences"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#241C18"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/initial_message"
                        android:textColor="#FF6B00"
                        android:textSize="11sp"
                        android:letterSpacing="0.1"
                        android:fontFamily="@font/font_koda"
                        android:layout_marginBottom="10dp"/>

                    <EditText
                        android:id="@+id/et_message"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:background="@drawable/bg_input"
                        android:textColor="#F2EFE9"
                        android:textColorHint="#7A7A85"
                        android:hint="@string/message_hint"
                        android:padding="14dp"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_koda"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_ticket"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/create_and_open_chat"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/font_koda"
                android:letterSpacing="0.04"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                app:backgroundTint="#FF6B00"
                app:cornerRadius="12dp"
                app:elevation="6dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
