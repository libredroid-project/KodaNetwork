# One dashboard: https://<server>.kodaserv.eu -> tunnel port of that server.
# Generated by setup-kodadash-https.sh - do not edit by hand.
server {
    # Port 443 is owned by the stream block in nginx.conf (SNI preread); every
    # https vhost lives on 127.0.0.1:8443 like the apex and the api vhost. A
    # dashboard vhost that listened on 443 itself made the whole reload fail
    # with "bind() 443 already in use" - and nginx then silently kept serving
    # the OLD configuration, which is why dashboards never went https.
    listen 127.0.0.1:8443 ssl http2 proxy_protocol;
    listen [::1]:8443 ssl http2 proxy_protocol;

    # the real client IP arrives through the PROXY protocol from the stream layer
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_header proxy_protocol;

    server_name {SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/{CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # A dashboard is private: never index it
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:{UPSTREAM_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        # The console uses Server-Sent Events: buffering would swallow the stream,
        # and the read timeout has to outlive the 15 second heartbeat of KodaDash.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;

        # file uploads through the dashboard
        client_max_body_size 25m;
    }
}
