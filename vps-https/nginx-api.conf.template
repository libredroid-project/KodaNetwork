# api.kodanetwork.eu: the public KodaHosting API.
# Generated from vps-https/nginx-api.conf.template by setup-api-https.sh - do not edit by hand.
#
# The stream block in nginx.conf already routes every unknown SNI to 127.0.0.1:8443
# (the TLS layer with one server block per host), so this file only has to serve the
# name itself: port 80 keeps the ACME challenge alive, 8443 forwards to the Supabase
# edge function "api", which routes /v1/* on its own (see supabase/functions/api).
server {
    listen 80;
    listen [::]:80;
    server_name {SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 127.0.0.1:8443 ssl http2 proxy_protocol;
    listen [::1]:8443 ssl http2 proxy_protocol;
    server_name {SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/{CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # request bodies here are json metadata only, packages and images upload
    # straight to storage through signed urls
    client_max_body_size 1m;

    # the human readable status page behind /
    location = / {
        proxy_pass https://{API_UPSTREAM_HOST}/functions/v1/api/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host {API_UPSTREAM_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # what the api's rate limiter counts: nginx REPLACES this header with the
        # real peer, so a client-sent X-Koda-Client-IP can never spoof the bucket.
        proxy_set_header X-Koda-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # the supabase gateway serves function html as text/plain with a sandbox
        # csp; put the real content type back for the browser
        proxy_hide_header Content-Type;
        proxy_hide_header Content-Security-Policy;
        add_header Content-Type "text/html; charset=utf-8" always;
    }

    # /v1/* -> the function router (the trailing slash keeps the /v1/ path intact)
    location / {
        proxy_pass https://{API_UPSTREAM_HOST}/functions/v1/api/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host {API_UPSTREAM_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # what the api's rate limiter counts: nginx REPLACES this header with the
        # real peer, so a client-sent X-Koda-Client-IP can never spoof the bucket.
        proxy_set_header X-Koda-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
