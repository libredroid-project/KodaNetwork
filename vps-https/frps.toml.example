# Minimal frps starting point for a self-hosted KodaHosting instance.
# The app asks get-tunnel-config for these values, so:
#   * auth.token must be the same value as the FRP_TOKEN function secret
#   * 7000 is the control port the app connects to
#   * 30000-59999 are the public Minecraft and KodaDash ports
#   * the frps dashboard stays on localhost, do not expose it

bindPort = 7000

auth.method = "token"
auth.token = "CHANGE_ME_SAME_AS_FRP_TOKEN"

allowPorts = [
  { start = 30000, end = 59999 }
]

webServer.addr = "127.0.0.1"
webServer.port = 7500
webServer.user = "admin"
webServer.password = "CHANGE_ME"
