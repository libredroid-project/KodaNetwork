# Discord Developer Portal -> Applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional. The bot picks a text channel whose name contains changelog/releases/announcements/news/
# updates by itself. If none matches it prints every channel with its id - put that id here then.
DISCORD_CHANNEL_ID=

# Optional. Slash commands show up instantly when a server is set; without it the bot uses the first
# server it has been invited to.
DISCORD_GUILD_ID=

# Supabase (service role - the bot marks releases as announced)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# How often to look for new releases (seconds)
POLL_SECONDS=60
