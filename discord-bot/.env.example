# Discord Developer Portal -> Applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Channel that receives the release announcements (right click channel -> Copy Channel ID,
# needs Developer Mode in Discord settings)
DISCORD_CHANNEL_ID=

# Optional: put the slash commands into one server (they show up instantly). Leave empty for global.
DISCORD_GUILD_ID=

# Supabase (service role - the bot marks releases as announced)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# How often to look for new releases (seconds)
POLL_SECONDS=60
